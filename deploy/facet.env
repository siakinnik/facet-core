# Environment for facet.service (installed as /etc/facet/facet.env).
# Uncomment what you need, then: sudo systemctl restart facet

# UI language until one is picked in Settings (en, ru).
#FACET_LANG=en

# Touchscreen orientation fix: any of swap, invx, invy (comma separated).
#FACET_TOUCH_TRANSFORM=swap,invy

# UI scale; default is min(width, height) / 480.
#FACET_SCALE=2

# Output devices.
#FACET_FB=/dev/fb0
#FACET_TTY=/dev/tty0

# Extra fonts directory (regular.ttf, medium.ttf, light.ttf or any known family).
#FACET_FONT_DIR=/opt/fonts

# Extra plugin directories, ':' separated.
#FACET_PLUGIN_PATH=/opt/facet-plugins

# Log every touch down/up (touchscreen debugging).
#FACET_DEBUG_INPUT=1
